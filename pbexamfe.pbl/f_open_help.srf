//objectcomments Opens the help at the topic of a window
global type f_open_help from function_object
end type

forward prototypes
global function integer f_open_help (string as_key)
end prototypes

global function integer f_open_help (string as_key);//////////////////////////////////////////////////////////////////////
//
// Function: f_open_help
//
// Purpose: starts the help engine and opens the appropriate topic
//
//	Scope: public
//
//	Arguments: as_key		the key (window name) that determines which
//								help will be displayed
//		
//	Returns:  1		indicates success
//				-1		error (the help couldn't be shown)
//
//////////////////////////////////////////////////////////////////////
n_cst_help lnv_Help

// The PDF help (exampl.pdf) at the topic of the window, or the HTML Help (exampl.chm) when the
// PDF isn't there: see n_cst_help
If lnv_Help.of_ShowHelp(as_key) <> 1 Then Return -1
Return 1
end function

