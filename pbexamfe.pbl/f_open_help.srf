//objectcomments Opens the w_help window
global type f_open_help from function_object
end type

forward prototypes
global function integer f_open_help (string as_key)
end prototypes

global function integer f_open_help (string as_key);//////////////////////////////////////////////////////////////////////
//
// Function: f_open_help
//
// Purpose: starts the help engine and opens the appropriate topic
//
//	Scope: public
//
//	Arguments: as_key		the key (window name) that determines which
//								help will be displayed
//		
//	Returns:  1		indicates success
//				-1		error (problem reading from database)
//
//////////////////////////////////////////////////////////////////////
int li_major, li_minor
string ls_helpfile
ContextInformation lcx_key

/*  Get PB Version.    */
ge_environment.GetContextService ( "ContextInformation", lcx_key)
lcx_key.GetMajorVersion ( li_major )
lcx_key.GetMinorVersion ( li_minor )

// Use the full path to the help file in the examples directory. A bare file name is
// resolved against the current directory, which is the PowerBuilder IDE directory
// when the examples are run from the IDE.
ls_helpfile = gs_ExampleDir + "\exampl.chm"
If Len(gs_ExampleDir) = 0 Or Not FileExists(ls_helpfile) Then ls_helpfile = "exampl.chm"

//ShowHelp("exampl" + String ( li_major ) + String ( li_minor ) + ".chm", KeyWord!, as_Key)
ShowHelp(ls_helpfile, KeyWord!, as_Key)		//2017.10.10 modified by wukaichen, reason: change file name to exampl.chm
Return 1
end function

